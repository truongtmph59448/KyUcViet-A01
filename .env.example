# GEMINI_API_KEY: Required for Gemini AI API calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Optional server-side administrator passcode for internal catalog management.
# If left empty, a first-run administrator passcode can be claimed in the Quản lý nội bộ screen.
ADMIN_PASSWORD=
